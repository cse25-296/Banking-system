<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="580.0" prefWidth="680.0" spacing="12.0"
      xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
      fx:controller="banking.controller.AccountController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label fx:id="welcomeLabel" text="Customer Account Dashboard">
            <font>
                <Font name="System Bold" size="18.0"/>
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" text="Logout"/>
    </HBox>

    <Separator/>

    <GridPane hgap="12.0" vgap="8.0">
        <Label text="Select Account:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="accountSelector" onAction="#handleAccountChange" prefWidth="250.0" promptText="Choose Account" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Account Type:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="accountTypeLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Branch:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="branchLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Account Status:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label fx:id="accountStatusLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Current Balance:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Label fx:id="balanceLabel" text="BWP 0.00" GridPane.columnIndex="1" GridPane.rowIndex="4">
            <font>
                <Font name="System Bold" size="14.0"/>
            </font>
        </Label>
    </GridPane>

    <Separator/>

    <Label text="Perform Transaction:"/>
    <HBox spacing="10.0">
        <TextField fx:id="amountField" prefWidth="150.0" promptText="Amount (BWP)"/>
        <Button fx:id="depositButton" mnemonicParsing="false" onAction="#handleDeposit" text="Deposit"/>
        <Button fx:id="withdrawButton" mnemonicParsing="false" onAction="#handleWithdraw" text="Withdraw"/>
        <Button fx:id="payInterestButton" mnemonicParsing="false" onAction="#handlePayInterest" text="Apply Monthly Interest"/>
    </HBox>

    <HBox spacing="10.0">
        <TextField fx:id="targetAccountField" prefWidth="190.0" promptText="Target Account (e.g. INV-2001)"/>
        <Button fx:id="transferButton" mnemonicParsing="false" onAction="#handleTransfer" text="Transfer Funds"/>
    </HBox>

    <Label fx:id="statusLabel" textFill="BLUE"/>

    <Label text="Transaction History:"/>
    <TextArea fx:id="transactionHistoryArea" editable="false" prefHeight="150.0" promptText="Recent transactions will appear here..."/>
</VBox>
