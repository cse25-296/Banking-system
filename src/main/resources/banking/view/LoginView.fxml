<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="banking.controller.LoginController">
   <children>
      <Label layoutX="235.0" layoutY="35.0" text="Banking System Login" />
      <ComboBox fx:id="roleComboBox" layoutX="215.0" layoutY="85.0" prefWidth="170.0" promptText="Select Role" />
      <TextField fx:id="usernameField" layoutX="215.0" layoutY="135.0" prefWidth="170.0" promptText="Enter User ID" />
      <PasswordField fx:id="passwordField" layoutX="215.0" layoutY="185.0" prefWidth="170.0" promptText="Enter Password" />
      <Button fx:id="loginButton" layoutX="255.0" layoutY="235.0" mnemonicParsing="false" onAction="#handleLogin" prefWidth="90.0" text="Login" />
      <Label fx:id="messageLabel" layoutX="150.0" layoutY="285.0" prefWidth="300.0" textFill="RED" />
   </children>
</AnchorPane>
