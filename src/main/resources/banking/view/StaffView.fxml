<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="580.0" prefWidth="680.0" spacing="12.0"
      xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
      fx:controller="banking.controller.StaffController">
    <padding>
        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label text="Bank Staff Administration Portal">
            <font>
                <Font name="System Bold" size="18.0"/>
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" text="Logout"/>
    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="Open Customer Account">
                <content>
                    <VBox spacing="10.0">
                        <padding><Insets top="15.0" right="10.0" bottom="10.0" left="10.0"/></padding>
                        <GridPane hgap="12.0" vgap="8.0">
                            <Label text="Customer Category:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <ComboBox fx:id="customerCategoryBox" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="First / Company Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <TextField fx:id="firstNameField" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="Surname / Reg No:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <TextField fx:id="surnameField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label text="ID / Tax Number:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <TextField fx:id="idNumberField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                            <Label text="Account Type:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                            <ComboBox fx:id="accountTypeBox" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                            <Label text="Branch:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                            <TextField fx:id="branchField" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                            <Label text="Initial Deposit (BWP):" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                            <TextField fx:id="initialDepositField" promptText="Min BWP 500.00 for Investment" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                            <Label text="Employer Company:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                            <TextField fx:id="companyNameField" promptText="Required for Cheque Account" GridPane.columnIndex="1" GridPane.rowIndex="8"/>

                            <Label text="Company Address:" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                            <TextField fx:id="companyAddressField" promptText="Required for Cheque Account" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
                        </GridPane>
                        <Button fx:id="openAccountButton" mnemonicParsing="false" onAction="#handleOpenAccount" text="Create Customer &amp; Open Account"/>
                        <Label fx:id="statusLabel" textFill="GREEN"/>
                    </VBox>
                </content>
            </Tab>

            <Tab text="Manage Accounts &amp; Reports">
                <content>
                    <VBox spacing="12.0">
                        <padding><Insets top="15.0" right="10.0" bottom="10.0" left="10.0"/></padding>
                        <Label text="Change Account Status (Activate / Suspend / Close):">
                            <font><Font name="System Bold" size="13.0"/></font>
                        </Label>
                        <HBox spacing="10.0">
                            <TextField fx:id="manageAccountField" prefWidth="180.0" promptText="Account No (e.g. SAV-1001)"/>
                            <ComboBox fx:id="statusComboBox" prefWidth="140.0"/>
                            <Button mnemonicParsing="false" onAction="#handleUpdateAccountStatus" text="Update Status"/>
                        </HBox>
                        <Label fx:id="manageStatusLabel" textFill="BLUE"/>

                        <Separator/>

                        <HBox spacing="10.0">
                            <Button mnemonicParsing="false" onAction="#handleGenerateCustomerReport" text="Customer Accounts Report"/>
                            <Button mnemonicParsing="false" onAction="#handleGenerateTransactionReport" text="Transaction Audit Report"/>
                            <Button mnemonicParsing="false" onAction="#handleApplyAllMonthlyInterest" text="Run End-of-Month Interest (All)"/>
                        </HBox>

                        <TextArea fx:id="reportOutputArea" editable="false" prefHeight="260.0" promptText="Generated bank reports will appear here..."/>
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
